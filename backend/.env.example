# 数据库
DATABASE_URL=sqlite+aiosqlite:///./interview_agent.db

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM 配置（多模型兼容）
# 可选: local / openai / moonshot / deepseek / anthropic / custom
LLM_PROVIDER=local
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_ALLOW_FALLBACK=false
LLM_INPUT_PRICE_PER_1K_TOKENS_CNY=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS_CNY=0

# 应用配置
APP_NAME=面试简历 Agent
APP_VERSION=0.1.0
APP_ENV=local
PUBLIC_BASE_URL=http://127.0.0.1:5174
ENFORCE_RELEASE_CHECKS=true
AUTO_CREATE_DB=true
DEBUG=true
ENABLE_DOCS=true
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_RESUME_TEXT_LENGTH=80000
MAX_JD_TEXT_LENGTH=40000
MAX_ANSWER_LENGTH=8000

# 安全配置
ADMIN_EMAILS=
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_API_REQUESTS=180

# 商业化配置
BILLING_ENABLED=false
PAYMENT_PROVIDER=
BILLING_UPGRADE_CONTACT=
FREE_RESUME_QUOTA=1
FREE_INTERVIEW_QUOTA=1
FREE_OPTIMIZE_QUOTA=1
FREE_JD_ADAPT_QUOTA=1
FREE_REPORT_EXPORT_QUOTA=0
PRO_MONTHLY_PRICE_CNY=39
PRO_RESUME_QUOTA=10
PRO_INTERVIEW_QUOTA=20
PRO_OPTIMIZE_QUOTA=30
PRO_JD_ADAPT_QUOTA=30
PRO_REPORT_EXPORT_QUOTA=20
SPRINT_PACKAGE_PRICE_CNY=129

# RAG / vector search
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=mianshiagent_knowledge_bge_m3
QDRANT_RESUME_COLLECTION=mianshiagent_resume_bge_m3
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=5
QDRANT_SYNC_ON_STARTUP=true
RESUME_CHUNK_SIZE=700
RESUME_CHUNK_OVERLAP=100
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=120

# Embedding. Local BGE-M3 returns 1024-dim vectors.
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=models
EMBEDDING_HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_USE_FP16=false
EMBEDDING_ALLOW_FALLBACK=false

# Reranker. Optional; keep disabled when local model is not installed.
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TOP_K=20
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=1024
RERANK_TIMEOUT_SECONDS=60
RERANK_DEVICE=cpu
RERANK_USE_FP16=false
RERANK_ALLOW_FALLBACK=true

# Async tasks
TASK_QUEUE_BACKEND=local
TASK_REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_NAME=mianshiagent
TASK_JOB_TIMEOUT_SECONDS=900
TASK_RESULT_TTL_SECONDS=86400
TASK_FAILURE_TTL_SECONDS=604800
TASK_ALLOW_LOCAL_FALLBACK=true
TASK_MAX_RETRIES=1
TASK_PROGRESS_POLL_SECONDS=1.5

# Operations / monitoring
METRICS_ENABLED=true
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
DEPLOYMENT_COLOR=blue
RELEASE_CHANNEL=stable
CANARY_PERCENT=0
ALERT_NOTIFY_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_MIN_SEVERITY=critical
ALERT_DEDUPE_MINUTES=60
QUALITY_EVAL_CANDIDATE_SCORE_THRESHOLD=2
