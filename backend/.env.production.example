# Production example. Do not copy values blindly.

# 数据库：生产必须使用 PostgreSQL
DATABASE_URL=postgresql+asyncpg://interview_agent:REPLACE_PASSWORD@postgres:5432/interview_agent

# 认证：生产必须使用 32 位以上随机密钥
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM：生产收费版必须接入真实模型，不使用 local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=REPLACE_LLM_KEY
LLM_BASE_URL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_ALLOW_FALLBACK=false
LLM_INPUT_PRICE_PER_1K_TOKENS_CNY=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS_CNY=0
LLM_RESUME_PARSE_MODEL=gpt-4o-mini
LLM_RESUME_OPTIMIZE_MODEL=gpt-4o
LLM_JD_ADAPT_MODEL=gpt-4o
LLM_INTERVIEW_QUESTION_MODEL=gpt-4o
LLM_ANSWER_SCORE_MODEL=gpt-4o-mini
LLM_INTERVIEW_REPORT_MODEL=gpt-4o
PROMPT_VERSION_RESUME_PARSE=resume_parse_v1
PROMPT_VERSION_RESUME_OPTIMIZE=resume_optimize_v1
PROMPT_VERSION_JD_ADAPT=jd_adapt_v3
PROMPT_VERSION_INTERVIEW_QUESTION=interview_question_v3
PROMPT_VERSION_ANSWER_SCORE=answer_score_v2
PROMPT_VERSION_INTERVIEW_REPORT=interview_report_v2

# 应用
APP_NAME=面试简历 Agent
APP_VERSION=0.1.0
APP_ENV=production
PUBLIC_BASE_URL=https://app.example.com
ENFORCE_RELEASE_CHECKS=true
AUTO_CREATE_DB=false
DEBUG=false
ENABLE_DOCS=false

# 文件/输入限制
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=10485760
MAX_RESUME_TEXT_LENGTH=80000
MAX_JD_TEXT_LENGTH=40000
MAX_ANSWER_LENGTH=8000

# Internal-only process-local Agent shadow inspection API. Never enable in production.
AGENT_SHADOW_API_ENABLED=false
AGENT_RUN_STORE_BACKEND=postgresql

# 安全：只允许正式域名。同域 Docker 部署时 TRUSTED_HOSTS 使用前端域名；
# 独立 API 域名部署时改为 api.example.com。
ADMIN_EMAILS=admin@example.com
CORS_ALLOW_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_API_REQUESTS=180

# RAG / vector search
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_LOCAL_PATH=
QDRANT_API_KEY=REPLACE_QDRANT_KEY_IF_NEEDED
QDRANT_COLLECTION=mianshiagent_knowledge_bge_m3
QDRANT_RESUME_COLLECTION=mianshiagent_resume_bge_m3
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=5
QDRANT_SYNC_ON_STARTUP=false
RESUME_CHUNK_SIZE=700
RESUME_CHUNK_OVERLAP=100
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=120

# Production recommendation: use a managed/OpenAI-compatible embedding endpoint.
# Local BGE-M3 is fine for private deployments but slower on CPU.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_API_KEY=REPLACE_EMBEDDING_KEY
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/data/models
EMBEDDING_HF_ENDPOINT=https://huggingface.co
EMBEDDING_USE_FP16=false
EMBEDDING_ALLOW_FALLBACK=false

# Reranker. Use a GPU local service or a managed rerank endpoint in production.
RERANK_PROVIDER=remote
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://rerank.example.com/v1
RERANK_API_KEY=REPLACE_RERANK_KEY
RERANK_TOP_K=20
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=1024
RERANK_TIMEOUT_SECONDS=60
RERANK_DEVICE=cpu
RERANK_USE_FP16=false
RERANK_ALLOW_FALLBACK=true

# Async tasks
TASK_QUEUE_BACKEND=redis_rq
TASK_REDIS_URL=redis://redis:6379/0
TASK_QUEUE_NAME=mianshiagent
TASK_JOB_TIMEOUT_SECONDS=900
TASK_RESULT_TTL_SECONDS=86400
TASK_FAILURE_TTL_SECONDS=604800
TASK_ALLOW_LOCAL_FALLBACK=false
TASK_MAX_RETRIES=2
TASK_PROGRESS_POLL_SECONDS=1.5

# Operations / monitoring
METRICS_ENABLED=true
BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
DEPLOYMENT_COLOR=blue
RELEASE_CHANNEL=stable
CANARY_PERCENT=0

# Active alert notifications. Use a Feishu/WeCom/Sentry-compatible webhook gateway.
ALERT_NOTIFY_ENABLED=true
ALERT_WEBHOOK_URL=https://alerts.example.com/webhook/mianshiagent
ALERT_WEBHOOK_TOKEN=REPLACE_ALERT_WEBHOOK_TOKEN
ALERT_MIN_SEVERITY=critical
ALERT_DEDUPE_MINUTES=60
