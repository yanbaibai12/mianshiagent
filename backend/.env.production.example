# Production example. Do not copy values blindly.

# 数据库：生产必须使用 PostgreSQL
DATABASE_URL=postgresql+asyncpg://interview_agent:REPLACE_PASSWORD@postgres:5432/interview_agent

# 认证：生产必须使用 32 位以上随机密钥
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM：生产收费版必须接入真实模型，不使用 local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=REPLACE_LLM_KEY
LLM_BASE_URL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_ALLOW_FALLBACK=false
LLM_INPUT_PRICE_PER_1K_TOKENS_CNY=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS_CNY=0

# 应用
APP_NAME=面试简历 Agent
APP_VERSION=0.1.0
APP_ENV=production
PUBLIC_BASE_URL=https://app.example.com
ENFORCE_RELEASE_CHECKS=true
AUTO_CREATE_DB=false
DEBUG=false
ENABLE_DOCS=false

# 文件/输入限制
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=10485760
MAX_RESUME_TEXT_LENGTH=80000
MAX_JD_TEXT_LENGTH=40000
MAX_ANSWER_LENGTH=8000

# 安全：只允许正式域名
ADMIN_EMAILS=admin@example.com
CORS_ALLOW_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_API_REQUESTS=180

# 商业化：未接支付时可先使用 manual + 人工开通
BILLING_ENABLED=true
PAYMENT_PROVIDER=manual
BILLING_UPGRADE_CONTACT=sales@example.com
FREE_RESUME_QUOTA=1
FREE_INTERVIEW_QUOTA=1
FREE_OPTIMIZE_QUOTA=1
FREE_JD_ADAPT_QUOTA=1
FREE_REPORT_EXPORT_QUOTA=0
PRO_MONTHLY_PRICE_CNY=39
PRO_RESUME_QUOTA=10
PRO_INTERVIEW_QUOTA=20
PRO_OPTIMIZE_QUOTA=30
PRO_JD_ADAPT_QUOTA=30
PRO_REPORT_EXPORT_QUOTA=20
SPRINT_PACKAGE_PRICE_CNY=129
