COMPOSE_PROJECT_NAME=mianshiagent

# Compose reads this backend env file at container runtime.
# Copy backend/.env.production.example to backend/.env.production and replace every REPLACE_* value.
BACKEND_ENV_FILE=./backend/.env.production

# Use URL-safe characters for POSTGRES_PASSWORD because it is interpolated into DATABASE_URL.
POSTGRES_DB=interview_agent
POSTGRES_USER=interview_agent
POSTGRES_PASSWORD=change-me-use-a-long-random-url-safe-password

# Public entrypoint. Put your CDN/Nginx/HTTPS gateway in front of this port.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8080

# Same-domain deployment:
# Browser -> https://app.example.com -> frontend nginx -> backend /api
PUBLIC_BASE_URL=https://app.example.com
CORS_ALLOW_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
VITE_API_BASE_URL=/api

# If you deploy a separate API domain, set:
# TRUSTED_HOSTS=api.example.com
# VITE_API_BASE_URL=https://api.example.com

BACKEND_IMAGE_TAG=local
FRONTEND_IMAGE_TAG=local

# Use a nearby PyPI mirror when Docker build cannot reach files.pythonhosted.org reliably.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
